# Marketing site — Supabase
#
# Reads published content from the `marketing` schema with the anon key; RLS
# restricts that key to published rows, so a draft cannot leak.
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Server-only. Used by server actions to write leads, Secure Score submissions
# and workshop registrations — those tables have no anon policy at all, so this
# is the only way in. Never prefix it with NEXT_PUBLIC_; that would ship it to
# the browser and hand anyone full read access to every captured enquiry.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Marketing site — Supabase
#
# Reads published content from the `marketing` schema with the anon key; RLS
# restricts that key to published rows, so a draft cannot leak.
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Server-only. Used by server actions to write leads, Secure Score submissions
# and workshop registrations — those tables have no anon policy at all, so this
# is the only way in. Never prefix it with NEXT_PUBLIC_; that would ship it to
# the browser and hand anyone full read access to every captured enquiry.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Server-only. Two jobs, both for the Secure Score email verification:
#   1. authorises calls to the marketing-assessment-mailer edge function
#   2. peppers the one-time-code HMAC, so a leaked verification table does not
#      hand anyone a working code (six digits is a 10^6 space — an unkeyed hash
#      would fall to a wordlist instantly)
# Must be byte-identical to the MARKETING_WEBHOOK_SECRET set in Supabase
# secrets, or codes will never verify and no mail will be sent.
MARKETING_WEBHOOK_SECRET=<same value as the Supabase secret>
